{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "FunctionName": {
      "defaultValue": "Bitwarden",
      "minLength": 1,
      "maxLength": 11,
      "type": "String",
      "metadata": {
        "description": "Base name for all created resources. Must be unique enough to avoid naming collisions (used in storage account and Function App names)."
      }
    },
    "WorkspaceName": {
      "type": "String",
      "metadata": {
        "description": "Name of the Log Analytics / Microsoft Sentinel workspace."
      }
    },
    "BitwardenUrl": {
      "type": "String",
      "metadata": {
        "description": "URL of your Bitwarden instance. For SaaS, use 'https://bitwarden.com' or 'https://bitwarden.eu'. For self-hosted, use the base URL of your instance (e.g., 'https://vault.mybitwarden.com')."
      }
    },
    "BitwardenClientId": {
      "type": "String",
      "metadata": {
        "description": "Bitwarden API client_id. Found in your Bitwarden organisation admin console under Settings → API Key."
      }
    },
    "BitwardenClientSecret": {
      "type": "SecureString",
      "metadata": {
        "description": "Bitwarden API client_secret. Found in your Bitwarden organisation admin console under Settings → API Key."
      }
    },
    "VNetSubnetResourceId": {
      "defaultValue": "",
      "type": "String",
      "metadata": {
        "description": "Resource ID of the delegated subnet for VNet integration (e.g. /subscriptions/.../subnets/func-subnet). Required when the Function App must reach on-premises resources via hub-spoke networking. Leave empty to skip VNet integration."
      }
    },
    "EventLookbackMinutes": {
      "defaultValue": 5,
      "type": "Int",
      "metadata": {
        "description": "Number of minutes to look back when querying Bitwarden events. Should match or slightly exceed the timer trigger interval."
      }
    },
    "packageUri": {
      "defaultValue": "https://aka.ms/sentinel-BitwardenFunctionApp-functionapp",
      "type": "String",
      "metadata": {
        "description": "URI of the zip package containing the Function App code."
      }
    }
  },
  "variables": {
    "FunctionName": "[concat(toLower(parameters('FunctionName')), uniqueString(resourceGroup().id))]",
    "StorageAccountName": "[take(concat(toLower(parameters('FunctionName')), uniqueString(resourceGroup().id)), 24)]",
    "identityName": "[format('uami-{0}', variables('FunctionName'))]",
    "dceName": "[concat('bitwarden-dce-', uniqueString(resourceGroup().id))]",
    "dcrEventsName": "[concat('bitwarden-dcr-events-', uniqueString(resourceGroup().id))]",
    "logWsResId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]",
    "storageSuffix": "[environment().suffixes.storage]",
    "monitoringMetricsPublisherRoleId": "3913510d-42f4-4e42-8a64-420c390055eb",
    "useVNet": "[not(empty(parameters('VNetSubnetResourceId')))]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('identityName')]",
      "location": "[resourceGroup().location]"
    },
    {
      "type": "Microsoft.Insights/dataCollectionEndpoints",
      "apiVersion": "2021-09-01-preview",
      "name": "[variables('dceName')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "networkAcls": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2022-10-01",
      "name": "[concat(parameters('WorkspaceName'), '/BitwardenEventLogs_CL')]",
      "properties": {
        "schema": {
          "name": "BitwardenEventLogs_CL",
          "columns": [
            { "name": "TimeGenerated",    "type": "datetime" },
            { "name": "eventType",        "type": "int" },
            { "name": "itemId",           "type": "string" },
            { "name": "collectionId",     "type": "string" },
            { "name": "policyId",         "type": "string" },
            { "name": "installationId",   "type": "string" },
            { "name": "device",           "type": "int" },
            { "name": "ipAddress",        "type": "string" },
            { "name": "memberId",         "type": "string" },
            { "name": "memberUserId",     "type": "string" },
            { "name": "memberEmail",      "type": "string" },
            { "name": "memberName",       "type": "string" },
            { "name": "actingUserId",     "type": "string" },
            { "name": "actingUserEmail",  "type": "string" },
            { "name": "actingUserName",   "type": "string" },
            { "name": "groupId",          "type": "string" },
            { "name": "groupName",        "type": "string" },
            { "name": "serviceAccountId", "type": "string" },
            { "name": "projectId",        "type": "string" },
            { "name": "secretId",         "type": "string" }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2021-09-01-preview",
      "name": "[variables('dcrEventsName')]",
      "location": "[parameters('location')]",
      "properties": {
        "dataCollectionEndpointId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName'))]",
        "destinations": {
          "logAnalytics": [
            {
              "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
              "name": "[parameters('workspaceName')]"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "[variables('customTable')]"
            ],
            "destinations": [
              "[parameters('workspaceName')]"
            ],
            "outputStream": "[variables('customTable')]",
            "transformKql": "source | extend TimeGenerated = now()"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName'))]",
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('WorkspaceName'), 'BitwardenEventLogs_CL')]"
      ]
    },

    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(variables('dcrEventsName'), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), variables('monitoringMetricsPublisherRoleId'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Insights/dataCollectionRules', variables('dcrEventsName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]"
      ],
      "scope": "[resourceId('Microsoft.Insights/dataCollectionRules', variables('dcrEventsName'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('monitoringMetricsPublisherRoleId'))]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('FunctionName')]",
      "location": "[resourceGroup().location]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[parameters('AppInsightsWorkspaceResourceID')]"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2019-06-01",
      "name": "[variables('StorageAccountName')]",
      "location": "[resourceGroup().location]",
      "sku": {
        "name": "Standard_LRS",
        "tier": "Standard"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "networkAcls": {
          "bypass": "AzureServices",
          "virtualNetworkRules": [],
          "ipRules": [],
          "defaultAction": "Allow"
        },
        "encryption": {
          "services": {
            "file": { "keyType": "Account", "enabled": true },
            "blob": { "keyType": "Account", "enabled": true }
          },
          "keySource": "Microsoft.Storage"
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2019-06-01",
      "name": "[concat(variables('StorageAccountName'), '/default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('StorageAccountName'))]"
      ],
      "properties": {
        "cors": { "corsRules": [] },
        "deleteRetentionPolicy": { "enabled": false }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices",
      "apiVersion": "2019-06-01",
      "name": "[concat(variables('StorageAccountName'), '/default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('StorageAccountName'))]"
      ],
      "properties": {
        "cors": { "corsRules": [] }
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-03-01",
      "name": "[variables('FunctionName')]",
      "location": "[resourceGroup().location]",
      "kind": "functionapp",
      "sku": {
        "name": "[if(variables('useVNet'), 'EP1', 'Y1')]",
        "tier": "[if(variables('useVNet'), 'ElasticPremium', 'Dynamic')]"
      },
      "properties": {
        "reserved": false,
        "maximumElasticWorkerCount": "[if(variables('useVNet'), 20, json('null'))]"
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-03-01",
      "name": "[variables('FunctionName')]",
      "location": "[resourceGroup().location]",
      "kind": "functionapp",
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]",
        "[resourceId('Microsoft.Web/serverfarms', variables('FunctionName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('StorageAccountName'))]",
        "[resourceId('Microsoft.Insights/components', variables('FunctionName'))]",
        "[resourceId('Microsoft.Insights/dataCollectionRules', variables('dcrEventsName'))]",
        "[resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName'))]"
      ],
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]": {}
        }
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('FunctionName'))]",
        "httpsOnly": true,
        "reserved": false,
        "virtualNetworkSubnetId": "[if(variables('useVNet'), parameters('VNetSubnetResourceId'), json('null'))]",
        "vnetRouteAllEnabled": "[variables('useVNet')]",
        "siteConfig": {
          "linuxFxVersion": "PowerShell|7.4",
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "appSettings": [
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "powershell"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME_VERSION",
              "value": "7.4"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('StorageAccountName'), ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('StorageAccountName')), '2019-06-01').keys[0].value, ';EndpointSuffix=', toLower(variables('storageSuffix')))]"
            },
            {
              "name": "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('StorageAccountName'), ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('StorageAccountName')), '2019-06-01').keys[0].value, ';EndpointSuffix=', toLower(variables('storageSuffix')))]"
            },
            {
              "name": "WEBSITE_CONTENTSHARE",
              "value": "[toLower(variables('FunctionName'))]"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[reference(resourceId('Microsoft.Insights/components', variables('FunctionName')), '2020-02-02').InstrumentationKey]"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', variables('FunctionName')), '2020-02-02').ConnectionString]"
            },
            {
              "name": "AZURE_CLIENT_ID",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').clientId]"
            },
            {
              "name": "AZURE_TENANT_ID",
              "value": "[subscription().tenantId]"
            },
            {
              "name": "AZURE_DCE_ENDPOINT",
              "value": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName')), '2021-09-01-preview').logsIngestion.endpoint]"
            },
            {
              "name": "AZURE_DCR_EVENTS_IMMUTABLEID",
              "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', variables('dcrEventsName')), '2021-09-01-preview').immutableId]"
            },
            {
              "name": "BITWARDEN_CLIENT_ID",
              "value": "[parameters('BitwardenClientId')]"
            },
            {
              "name": "BITWARDEN_CLIENT_SECRET",
              "value": "[parameters('BitwardenClientSecret')]"
            },
            {
              "name": "BITWARDEN_URL",
              "value": "[parameters('BitwardenUrl')]"
            },
            {
              "name": "BITWARDEN_EVENT_LOOKBACK_MINUTES",
              "value": "[string(parameters('EventLookbackMinutes'))]"
            },
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "[parameters('packageUri')]"
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "FunctionAppName": {
      "type": "string",
      "value": "[variables('FunctionName')]"
    },
    "DCEEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName')), '2021-09-01-preview').logsIngestion.endpoint]"
    }
  }
}
