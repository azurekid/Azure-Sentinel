{
  "location": {
    "type": "string",
    "minLength": 1,
    "defaultValue": "[resourceGroup().location]",
    "metadata": {
      "description": "Not used directly. Added for parity with Microsoft solution packaging checks."
    }
  },
  "workspace-location": {
    "type": "string",
    "defaultValue": "[resourceGroup().location]",
    "metadata": {
      "description": "Workspace region for deploying solution resources."
    }
  },
  "workspace": {
    "type": "string",
    "defaultValue": "",
    "metadata": {
      "description": "Log Analytics workspace name where Microsoft Sentinel is enabled."
    }
  },
  "resourceGroupName": {
    "type": "string",
    "defaultValue": "[resourceGroup().name]",
    "metadata": {
      "description": "Resource group that contains the workspace."
    }
  },
  "subscription": {
    "type": "string",
    "defaultValue": "[last(split(subscription().id, '/'))]",
    "metadata": {
      "description": "Subscription id that contains the workspace."
    }
  },
  "profiles": {
    "type": "array",
    "defaultValue": [
      "1d96ff"
    ],
    "metadata": {
      "description": "NextDNS profile IDs to ingest."
    }
  },
  "nextDnsApiKeySecretUri": {
    "type": "securestring",
    "defaultValue": "nextdns-api-key",
    "metadata": {
      "description": "NextDNS API key value used by APIKey auth in RestApiPoller."
    }
  }
}
