                  },
                  {
                    "streams": ["[variables('customAnalyticsTable')]"],
                    "destinations": ["[parameters('workspaceName')]"],
                    "outputStream": "[variables('customAnalyticsTable')]",
                    "transformKql": "source | extend TimeGenerated = now(), queryCount = columnifexists('queries', 0) | project TimeGenerated, profileId, metric, name, status, queryCount, percentage"
                  }
                ]
              }
