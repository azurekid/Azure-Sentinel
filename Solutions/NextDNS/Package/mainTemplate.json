              ],
              "properties": {
                "dataCollectionEndpointId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName'))]",
                "streamDeclarations": "[createObject(variables('customTable'), createObject('columns', createArray(createObject('name', 'timestamp', 'type', 'string'), createObject('name', 'profileId', 'type', 'string'), createObject('name', 'domain', 'type', 'string'), createObject('name', 'root', 'type', 'string'), createObject('name', 'status', 'type', 'string'), createObject('name', 'type', 'type', 'string'), createObject('name', 'protocol', 'type', 'string'), createObject('name', 'encrypted', 'type', 'boolean'), createObject('name', 'clientIp', 'type', 'string'), createObject('name', 'client', 'type', 'string'), createObject('name', 'tracker', 'type', 'string'), createObject('name', 'deviceName', 'type', 'string'), createObject('name', 'device', 'type', 'dynamic'), createObject('name', 'reasons', 'type', 'dynamic'))), variables('customAnalyticsTable'), createObject('columns', createArray(createObject('name', 'name', 'type', 'string'), createObject('name', 'status', 'type', 'string'), createObject('name', 'queries', 'type', 'long'), createObject('name', 'percentage', 'type', 'real'), createObject('name', 'profileId', 'type', 'string'), createObject('name', 'metric', 'type', 'string'))))]",
