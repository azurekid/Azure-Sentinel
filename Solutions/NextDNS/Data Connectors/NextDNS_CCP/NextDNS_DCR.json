{
  "name": "NextDNSDCR",
  "apiVersion": "2023-04-01-preview",
  "type": "Microsoft.Insights/dataCollectionRules",
  "location": "{{location}}",
  "properties": {
    "dataCollectionEndpointId": "{{dataCollectionEndpointId}}",
    "streamDeclarations": {
      "Custom-NextDNS_CL": {
        "columns": [
          { "name": "timestamp", "type": "string" },
          { "name": "profileId", "type": "string" },
          { "name": "domain", "type": "string" },
          { "name": "root", "type": "string" },
          { "name": "status", "type": "string" },
          { "name": "type", "type": "string" },
          { "name": "protocol", "type": "string" },
          { "name": "encrypted", "type": "boolean" },
          { "name": "clientIp", "type": "string" },
          { "name": "client", "type": "string" },
          { "name": "tracker", "type": "string" },
          { "name": "deviceName", "type": "string" },
          { "name": "device", "type": "dynamic" },
          { "name": "reasons", "type": "dynamic" }
        ]
      },
      "Custom-NextDNSAnalytics_CL": {
        "columns": [
          { "name": "name", "type": "string" },
          { "name": "status", "type": "string" },
          { "name": "queries", "type": "long" },
          { "name": "percentage", "type": "real" },
          { "name": "profileId", "type": "string" },
          { "name": "metric", "type": "string" }
        ]
      }
    },
    "destinations": {
      "logAnalytics": [
        {
          "workspaceResourceId": "{{workspaceResourceId}}",
          "name": "clv2ws1"
        }
      ]
    },
    "dataFlows": [
      {
        "streams": [
          "Custom-NextDNS_CL"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "outputStream": "Custom-NextDNS_CL",
        "transformKql": "source | extend device_obj = todynamic(device) | project TimeGenerated = iff(isempty(timestamp), now(), todatetime(timestamp)), profileId = tostring(profileId), domain = tostring(domain), root = tostring(root), status = tostring(status), queryType = tostring(type), protocol = tostring(protocol), encrypted = tobool(encrypted), clientIp = tostring(clientIp), client = tostring(client), tracker = tostring(tracker), deviceName = iff(isempty(tostring(deviceName)), tostring(device_obj.name), tostring(deviceName)), deviceId = tostring(device_obj.id), deviceModel = tostring(device_obj.model), reasons = tostring(reasons), device = device_obj, RawData = pack_all()"
      },
      {
        "streams": [
          "Custom-NextDNSAnalytics_CL"
        ],
        "destinations": [
          "clv2ws1"
        ],
        "outputStream": "Custom-NextDNSAnalytics_CL",
        "transformKql": "source | extend TimeGenerated = now(), queryCount = columnifexists('queries', 0) | project TimeGenerated, profileId, metric, name, status, queryCount, percentage"
      }
    ]
  }
}
